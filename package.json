{
  "name": "youtube-language-helper",
  "description": "YouTube raw caption learning helper — M0",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:integration": "npm run build && node --test tests/integration/*.test.mjs",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "lucide-react": "0.479.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sbd": "1.0.19"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@wxt-dev/module-react": "1.2.2",
    "typescript": "5.9.3",
    "wxt": "0.21.4"
  }
}
